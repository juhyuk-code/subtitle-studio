{
  "name": "subtitle-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node scripts/run-python.mjs -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "tsc -b && vite build",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:update": "node scripts/build-desktop.mjs --stage-update",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "node scripts/run-python.mjs -m pytest backend/tests",
    "check": "npm run test && npm run test:api && npm run build"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.8"
  }
}
