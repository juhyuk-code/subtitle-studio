# Create a key at https://openrouter.ai/settings/keys.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Use one model for all language stages, or override each stage below.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CORRECTION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TRANSLATION_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_APP_URL=http://localhost:3000

SUBTITLE_STUDIO_DATA=./data
